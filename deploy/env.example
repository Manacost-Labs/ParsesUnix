# Copy to ~/.config/web-scraper/env (chmod 600). Never commit real values.
# Optional Telegram alert sink (only used if the alerter is configured for it):
# WEB_SCRAPER_TELEGRAM_TOKEN=
# WEB_SCRAPER_TELEGRAM_CHAT_ID=
# Point the package at the repo src if not pip-installed:
# WEB_SCRAPER_SRC=/home/debian/ParsesUnix/src
