{
  "name": "example-public-sandboxes",
  "description": "Public scraping sandboxes plus two live sites that permit this agent. Expectations measured directly, not assumed.",
  "skipped_by_policy": {
    "data.wowmeta.com": "robots.txt answers 403, which the RFC reads as disallow-all; the cross-origin JSON endpoint is therefore not fetched directly"
  },
  "targets": [
    {
      "url": "https://www.scrapethissite.com/pages/advanced/",
      "domain": "www.scrapethissite.com",
      "url_class": "page",
      "kind": "ssr_html",
      "notes": "server-rendered, 9.8 KB measured",
      "expected": {
        "content_kind": "html",
        "target_status": 200,
        "min_body_bytes": 4000,
        "canaries": [
          "Advanced Topics"
        ],
        "json_paths": [],
        "critical_fields": [
          "title"
        ]
      }
    },
    {
      "url": "https://www.scrapethissite.com/pages/forms/?page_num=2",
      "domain": "www.scrapethissite.com",
      "url_class": "listing",
      "kind": "listing",
      "notes": "page 2 of a paginated listing, 50 KB measured",
      "expected": {
        "content_kind": "html",
        "target_status": 200,
        "min_body_bytes": 20000,
        "canaries": [
          "hockey"
        ],
        "json_paths": [],
        "critical_fields": [
          "title"
        ]
      }
    },
    {
      "url": "https://www.scrapethissite.com/pages/simple/",
      "domain": "www.scrapethissite.com",
      "url_class": "listing",
      "kind": "large_html",
      "notes": "203 KB measured \u2014 large enough to catch truncation",
      "expected": {
        "content_kind": "html",
        "target_status": 200,
        "min_body_bytes": 100000,
        "canaries": [
          "country-name"
        ],
        "json_paths": [],
        "critical_fields": [
          "title"
        ]
      }
    },
    {
      "url": "https://www.scrapethissite.com/pages/ajax-javascript/?ajax=true&year=2015",
      "domain": "www.scrapethissite.com",
      "url_class": "rankings",
      "kind": "json_endpoint",
      "notes": "the site's own AJAX endpoint: 16 objects, application/json",
      "expected": {
        "content_kind": "json",
        "target_status": 200,
        "min_body_bytes": 500,
        "canaries": [],
        "json_paths": [
          "0.title",
          "0.year"
        ],
        "critical_fields": []
      }
    },
    {
      "url": "https://www.scrapethissite.com/pages/definitely-not-here-xyz",
      "domain": "www.scrapethissite.com",
      "url_class": "page",
      "kind": "dead_url",
      "notes": "the row that catches the defect that hit three adapters: a provider must report 404 as the TARGET's status",
      "expected": {
        "content_kind": "html",
        "target_status": 404,
        "min_body_bytes": 500,
        "canaries": [],
        "json_paths": [],
        "critical_fields": []
      }
    },
    {
      "url": "https://wowmeta.com/",
      "domain": "wowmeta.com",
      "url_class": "home",
      "kind": "csr_shell",
      "notes": "client-rendered; unrendered shell measured at 2 035 bytes",
      "expected": {
        "content_kind": "html",
        "target_status": 200,
        "min_body_bytes": 10000,
        "canaries": [],
        "json_paths": [],
        "critical_fields": []
      }
    },
    {
      "url": "https://hsreplay.net/",
      "domain": "hsreplay.net",
      "url_class": "home",
      "kind": "hard_block",
      "notes": "anti-bot candidate. A direct fetch from the operator's own address succeeds (28 KB measured); whether it does from a provider's egress is the question this row asks",
      "expected": {
        "content_kind": "html",
        "target_status": 200,
        "min_body_bytes": 10000,
        "canaries": [
          "Hearthstone"
        ],
        "json_paths": [],
        "critical_fields": []
      }
    }
  ]
}
